rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Funciones de validación de seguridad (Attribute-Based Access Control)
    // ------------------------------------------------------------------------

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validación estricta del esquema de Producto de Pastelería
    function isValidProduct(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 120 &&
             data.categoria is string && data.categoria.size() > 0 && data.categoria.size() <= 50 &&
             data.precio is number && data.precio >= 0 &&
             data.unidad is string && data.unidad.size() > 0 && data.unidad.size() <= 20 &&
             data.disponible is bool &&
             (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() <= 1000)) &&
             (!('etiqueta' in data) || (data.etiqueta is string && data.etiqueta.size() <= 60)) &&
             (!('destacado' in data) || data.destacado is bool) &&
             (!('imagen' in data) || (data.imagen is string && data.imagen.size() <= 500000));
    }

    // ------------------------------------------------------------------------
    // Colección: /productos/{productId}
    // - Lectura pública: Clientes de index.html pueden consultar el catálogo en tiempo real
    // - Escritura validada: Permite crear, modificar y eliminar productos validando integridad
    // ------------------------------------------------------------------------
    match /productos/{productId} {
      // Clientes pueden leer y escuchar en tiempo real (onSnapshot) el catálogo
      allow read: if true;

      // Creación: Valida formato de ID y campos requeridos
      allow create: if isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().keys().hasAll(['nombre', 'categoria', 'precio', 'unidad', 'disponible']);

      // Edición de precio, disponibilidad, unidad, imagen, etc.
      allow update: if isValidId(productId) &&
                       isValidProduct(incoming());

      // Eliminación de producto desde el panel
      allow delete: if isValidId(productId);
    }

    // Default-deny para cualquier otra ruta no declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
